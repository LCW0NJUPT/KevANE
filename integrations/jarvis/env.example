# Add these values to Jarvis 0.6.0's TypeSafe/System One configuration.
export TYPESAFE_BASE_URL="http://127.0.0.1:8008"
export TYPESAFE_MODEL="kevane-0.6b"
# Jarvis uses a non-empty key to select its TypeSafe path. Without
# KEVANE_API_KEY, KevANE accepts any value on localhost.
export TYPESAFE_API_KEY="local"
